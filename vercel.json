{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python build_vercel.py",
  "functions": {
    "index.py": {
      "maxDuration": 30,
      "includeFiles": "data/models/onset_rf.joblib"
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
