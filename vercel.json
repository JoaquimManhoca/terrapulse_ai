{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python build_vercel.py",
  "functions": {
    "index.py": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
