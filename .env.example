# TerraPulse AI - copy to .env and adjust
SECRET_KEY=change-me-to-a-long-random-string

# Local default is SQLite. For Vercel, use a persistent PostgreSQL URL.
# DATABASE_URL=sqlite:///E:/code/nassa-app2/data/terrapulse.db
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
#
# Supabase: db.<ref>.supabase.co is IPv6-only and will NOT work on Vercel.
# Use the Transaction pooler (IPv4) instead:
# DATABASE_URL=postgresql://postgres.<ref>:password@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Alternatively keep the direct URL and let the app rewrite it to the pooler:
# SUPABASE_POOLER_HOST=aws-1-<region>.pooler.supabase.com
# SUPABASE_POOLER_PORT=6543

DEFAULT_LANGUAGE=pt
DEFAULT_REGION=manica
DEFAULT_CROP=milho

# Set false to run fully offline (NASA climatology + rules only)
FORECAST_ENABLED=true

# Vercel sets AUTO_TRAIN_MODEL=false by default; local default is true.
# AUTO_TRAIN_MODEL=false

# Phase 1: folder with NASA IMERG Early Daily .nc4 granules
# Defaults to <project>/download-data
# IMERG_DIR=E:/code/nassa-app2/download-data
IMERG_PATTERN=*.nc4

# Manica district, Mozambique 
MANICA_LAT=-18.8937
MANICA_LON=32.9252
MANICA_LON_MIN=32.69834
MANICA_LAT_MIN=-19.13725
MANICA_LON_MAX=33.17879
MANICA_LAT_MAX=-18.70926

# Agronomic rules (see docs/METODOLOGIA.md)
DECISION_DRY_DAY_MM=1.0
ONSET_WINDOW_DAYS=3
ONSET_THRESHOLD_MM=20.0
ONSET_DRY_SPELL_DAYS=7
ONSET_HORIZON_DAYS=21
SEASON_START_MONTH=10
SEASON_START_DAY=1
